<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Cho phép app gọi API qua internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Quyền đọc SMS để AI tự động phát hiện giao dịch -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    
    <!-- Quyền camera và storage để quét QR và hóa đơn -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.InZightApp"
        tools:targetApi="31"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- OnboardingActivity là màn hình khởi động -->
        <activity
            android:name=".view.OnboardingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- LoginActivity không còn là launcher -->
        <activity android:name=".view.LoginActivity" android:exported="false"/>

        <!--        <activity android:name=".view.LoginActivity"/>-->
        <activity android:name=".view.HomeActivity" android:exported="false"/>
        <activity android:name=".view.CommentActivity" android:exported="false"/>

        <activity android:name=".view.CreatePostActivity" android:exported="false"/>

        <activity android:name=".view.ChatActivity" android:exported="false"/>
        <activity android:name=".view.FinbotChatActivity" android:exported="false"/>

        <activity android:name=".view.CreateAccountActivity" android:exported="false"/>
        <activity android:name=".view.CreatePasswordActivity" android:exported="false"/>
        <activity android:name=".view.VerifyOtpActivity" android:exported="false"/>

        <activity android:name=".view.AdminUserManagementActivity" android:exported="false"/>
        <activity
            android:name=".view.AdminMainActivity"
            android:exported="false" />

        <!-- MainActivity vẫn khai báo nhưng không phải launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.InZightApp">
            <!-- Deep link nhận callback từ PayOS -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="inzight" android:host="payos" android:path="/payment-success" />
                <data android:scheme="inzight" android:host="payos" android:path="/payment-cancel" />
            </intent-filter>
        </activity>

        <!-- BroadcastReceiver để nhận SMS từ ngân hàng/ví điện tử -->
        <receiver
            android:name=".ai.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="1000">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider cho camera -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
