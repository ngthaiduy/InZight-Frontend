<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.BottomNavigationView.Custom" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="itemRippleColor">@color/home_primary</item>
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">8dp</item>
        <item name="itemBackground">@drawable/selector_bottom_nav_background</item>
        <item name="itemTextAppearanceActive">@style/Widget.BottomNavigationView.TextAppearance.Active</item>
        <item name="itemTextAppearanceInactive">@style/Widget.BottomNavigationView.TextAppearance</item>

        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawableStart">@drawable/ic_bullet_check</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/home_text_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginBottom">4dp</item>

        <item name="android:statusBarColor">@color/bgPrimary</item>
        <item name="android:navigationBarColor">@color/bgPrimary</item>
        <item name="colorPrimary">@color/gradientStart</item>
        <item name="colorPrimaryVariant">@color/gradientEnd</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:windowBackground">@color/bgPrimary</item>
    </style>

    <!-- Spinner Style -->
    <style name="SpinnerStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:textColor">@color/home_text_strong</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
</resources>

