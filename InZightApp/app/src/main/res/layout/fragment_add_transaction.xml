<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_header_vibrant"
    android:fillViewport="true"
    android:padding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="48dp"
            android:paddingBottom="24dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- Back button -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/bg_card_rounded"
                android:backgroundTint="#20FFFFFF"
                android:contentDescription="Back"
                android:padding="8dp"
                app:tint="@color/white"/>

            <!-- Header title -->
            <TextView
                android:id="@+id/tvHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add Transaction"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <!-- Common Container for Manual Entry and Image Entry -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:elevation="8dp">
            
            <!-- Tabs: Manual Entry / Enter by Photo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/tabManual"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Manual Entry"
                    android:textColor="#FF4081"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="12dp"
                    android:drawablePadding="8dp"
                    android:drawableTop="@drawable/ic_add" />
                
                <TextView
                    android:id="@+id/tabImage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enter by Photo"
                    android:textColor="#757575"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:padding="12dp"
                    android:drawablePadding="8dp"
                    android:drawableTop="@drawable/ic_camera" />
            </LinearLayout>
            
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp" />
            
            <!-- Tab indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">
                
                <View
                    android:id="@+id/indicatorManual"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="#FF4081" />
                
                <View
                    android:id="@+id/indicatorImage"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <!-- Tab 1: Manual Entry Content -->
            <LinearLayout
                android:id="@+id/layoutManualEntry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="visible">

            <!-- Tabs: Expense / Income -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_tab_pill"
                android:orientation="horizontal"
                android:weightSum="2"
                android:padding="4dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tabExpense"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Expense"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_tab_selected_pill" />

                <TextView
                    android:id="@+id/tabIncome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Income"
                    android:textStyle="bold"
                    android:textColor="#757575"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <!-- Amount -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Amount*"
                android:textStyle="bold"
                android:textColor="#333"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter amount"
                android:inputType="number"
                android:background="@drawable/bg_note_field"
                android:padding="16dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000"
                android:layout_marginBottom="20dp" />

            <!-- Category -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Category*"
                android:textStyle="bold"
                android:textColor="#333"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategoryCompact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:overScrollMode="never" />

            <!-- Date -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Transaction Date*"
                android:textStyle="bold"
                android:textColor="#333"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_note_field"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Today"
                    android:textColor="#111"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/btnPickDate"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_calendar"
                    android:contentDescription="Pick date"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#0288D1"/>
            </LinearLayout>

            <!-- Wallet -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wallet*"
                android:textStyle="bold"
                android:textColor="#333"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spWallet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_note_field"
                android:padding="12dp"
                android:layout_marginBottom="20dp" />

            <!-- Note -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Note"
                android:textStyle="bold"
                android:textColor="#333"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="top|start"
                android:hint="Enter note"
                android:background="@drawable/bg_note_field"
                android:padding="16dp"
                android:textSize="16sp" />
            </LinearLayout>
            
            <!-- Tab 2: Image Entry Content -->
            <LinearLayout
                android:id="@+id/layoutImageEntry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">
                
                <!-- Scan Receipt Card -->
                <LinearLayout
                    android:id="@+id/btnScanReceipt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_button_gradient"
                    android:padding="24dp"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_camera"
                        android:contentDescription="Scan icon"
                        app:tint="@color/white"
                        android:layout_marginBottom="12dp" />
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scan Receipt"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>
            
            <!-- Image Preview -->
            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:background="#F5F5F5"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />
            
            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />
            
            <!-- Extracted Transaction Info (will be filled by AI) -->
            <!-- Same form fields as manual entry, but will be auto-filled -->
            
            <!-- Tabs: Expense / Income (for image entry) -->
            <LinearLayout
                android:id="@+id/layoutTypeTabsImage"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_tab_pill"
                android:orientation="horizontal"
                android:weightSum="2"
                android:padding="4dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone">
                
                <TextView
                    android:id="@+id/tabExpenseImage"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Expense"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_tab_selected_pill" />
                
                <TextView
                    android:id="@+id/tabIncomeImage"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Income"
                    android:textStyle="bold"
                    android:textColor="#757575"
                    android:background="@android:color/transparent" />
            </LinearLayout>
            
            <!-- Auto-filled form fields (hidden initially, shown after scan) -->
            <!-- Amount -->
            <TextView
                android:id="@+id/tvAmountLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Amount*"
                android:textStyle="bold"
                android:textColor="#333"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />
            
            <EditText
                android:id="@+id/etAmountImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter amount"
                android:inputType="number"
                android:background="@drawable/bg_note_field"
                android:padding="16dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000"
                android:layout_marginBottom="20dp"
                android:visibility="gone" />
            
            <!-- Category -->
            <TextView
                android:id="@+id/tvCategoryLabelImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Category*"
                android:textStyle="bold"
                android:textColor="#333"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />
            
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategoryCompactImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:overScrollMode="never"
                android:visibility="gone" />
            
            <!-- Date -->
            <TextView
                android:id="@+id/tvDateLabelImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Transaction Date*"
                android:textStyle="bold"
                android:textColor="#333"
                android:textSize="16sp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
            
            <LinearLayout
                android:id="@+id/layoutDateImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_note_field"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:visibility="gone">
                
                <TextView
                    android:id="@+id/tvDateImage"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Today"
                    android:textColor="#111"
                    android:textSize="16sp" />
                
                <ImageView
                    android:id="@+id/btnPickDateImage"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_calendar"
                    android:contentDescription="Pick date"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#0288D1"/>
            </LinearLayout>
            
            <!-- Wallet -->
            <TextView
                android:id="@+id/tvWalletLabelImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wallet*"
                android:textStyle="bold"
                android:textColor="#333"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />
            
            <Spinner
                android:id="@+id/spWalletImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_note_field"
                android:padding="12dp"
                android:layout_marginBottom="20dp"
                android:visibility="gone" />
            
            <!-- Note -->
            <TextView
                android:id="@+id/tvNoteLabelImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Note"
                android:textStyle="bold"
                android:textColor="#333"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />
            
            <EditText
                android:id="@+id/etNoteImage"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="top|start"
                android:hint="Enter note"
                android:background="@drawable/bg_note_field"
                android:padding="16dp"
                android:textSize="16sp"
                android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveTransaction"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_button_gradient"
            android:fontFamily="sans-serif-medium"
            android:text="Save Transaction"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:elevation="4dp"
            app:backgroundTint="@null" />
    </LinearLayout>

</ScrollView>
