<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp"
    android:gravity="bottom">

    <!-- Message sent (right side) -->
    <LinearLayout
        android:id="@+id/layoutSent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSentMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="250dp"
            android:background="@drawable/bg_chat_sent"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:text="Message sent"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"
            android:elevation="2dp" />
    </LinearLayout>

    <!-- Message received (left side) -->
    <LinearLayout
        android:id="@+id/layoutReceived"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvReceivedMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="250dp"
            android:background="@drawable/bg_chat_received"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:text="Message received"
            android:textColor="@color/home_text_strong"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"
            android:elevation="2dp" />
    </LinearLayout>
</LinearLayout>

