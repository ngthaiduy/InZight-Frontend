<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="50dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back"
                app:tint="@color/home_text_strong"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Retirement Planning"
                    android:textColor="@color/home_text_strong"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your retirement Lifestyle Plan"
                    android:textColor="@color/home_text_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="italic"/>
            </LinearLayout>
            
             <View
                android:layout_width="24dp"
                android:layout_height="24dp" />
        </LinearLayout>

        <!-- Summary Cards Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:padding="12dp">

            <!-- Card 1: Total Funds -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#F5F5F5">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_savings"
                            app:tint="#1976D2"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Funds Needed"
                            android:textSize="11sp"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/home_text_strong"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvTotalFunds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 VNĐ"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/home_text_strong"/>
                    <TextView
                        android:id="@+id/tvTotalFundsNeeded"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 VNĐ"
                        android:textSize="14sp"
                        android:textColor="@color/home_text_muted"
                        android:visibility="gone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: % Lifestyle -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#F5F5F5">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_nav_optimizer"
                            app:tint="#5C6BC0"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="%Lifestyle vs Core Needs"
                            android:textSize="11sp"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/home_text_strong"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvLifestylePercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/home_text_strong"/>
                    <TextView
                        android:id="@+id/tvLifestyleVsCoreNeeds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textSize="14sp"
                        android:textColor="@color/home_text_muted"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Burn Rate -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#F5F5F5">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_category_shopping"
                            app:tint="#FFB300"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monthly Savings"
                        android:textSize="11sp"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/home_text_strong"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvMonthlySavings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 VNĐ"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/home_text_strong"/>
                    <TextView
                        android:id="@+id/tvAnnualBurnRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 VNĐ/năm"
                        android:textSize="14sp"
                        android:textColor="@color/home_text_muted"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Stress Level -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#F5F5F5">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_nav_retire"
                            app:tint="#795548"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Years to retirement"
                            android:textSize="11sp"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/home_text_strong"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvYearsToRetire"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 năm"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000000"/>
                    <TextView
                        android:id="@+id/tvLifestyleStressLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="THẤP"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/home_text_muted"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <!-- Main Content Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#E3F2FD">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:minHeight="400dp">

                <!-- Age Tabs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_home_switch_item"
                    android:backgroundTint="#FFFFFF"
                    android:padding="8dp"
                    android:layout_marginBottom="32dp">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="45-60"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textSize="16sp"
                        android:textColor="@color/home_text_strong"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="65-70"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textSize="16sp"
                        android:textColor="@color/home_text_strong"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="75-85"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textSize="16sp"
                        android:textColor="@color/home_text_strong"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=">90"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textSize="16sp"
                        android:textColor="@color/home_text_strong"/>
                </LinearLayout>

                <!-- Activity Tags (Scattered Look) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="40dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Travel"
                        android:background="@drawable/bg_home_switch_item"
                        android:backgroundTint="#80CBC4"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:gravity="center"
                        android:paddingHorizontal="40dp"
                        android:paddingVertical="12dp"
                        android:layout_gravity="start"
                        android:layout_marginStart="20dp"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Education"
                        android:background="@drawable/bg_home_switch_item"
                        android:backgroundTint="#80CBC4"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:gravity="center"
                        android:paddingHorizontal="40dp"
                        android:paddingVertical="12dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Healthcare"
                        android:background="@drawable/bg_home_switch_item"
                        android:backgroundTint="#548EAA"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:gravity="center"
                        android:paddingHorizontal="40dp"
                        android:paddingVertical="12dp"
                        android:layout_gravity="end"
                        android:layout_marginEnd="40dp"/>
                </LinearLayout>

                <!-- Spacer to push Bot Advice to bottom -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Bot Advice (Bubbles) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/imagebot"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reducing Travel"
                            android:background="@drawable/bg_home_switch_item"
                            android:backgroundTint="#BBDEFB"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:textStyle="bold|italic"
                            android:textColor="#000000"
                            android:layout_marginBottom="8dp"/>
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="From 5 to 3 years"
                            android:background="@drawable/bg_home_switch_item"
                            android:backgroundTint="#BBDEFB"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:textStyle="bold|italic"
                            android:textColor="#000000"
                            android:layout_marginBottom="8dp"
                            android:layout_marginStart="30dp"/>

                         <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Improve fund balances"
                            android:background="@drawable/bg_home_switch_item"
                            android:backgroundTint="#BBDEFB"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:textStyle="bold|italic"
                            android:textColor="#000000"
                            android:layout_marginStart="60dp"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePlan"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="SAVE PLAN"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            android:padding="12dp"
            android:backgroundTint="#007BFF"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>
