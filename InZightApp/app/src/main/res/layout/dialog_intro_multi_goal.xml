<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_round"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_multi_goal_bx" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Multi-Goal Planning"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/home_text_strong" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Plan for multiple financial goals, optimize your future value, and simulate scenarios."
        android:textSize="14sp"
        android:textColor="@color/home_text_regular" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartNow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="START NOW"
        android:textAllCaps="true"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/home_primary"
        app:cornerRadius="16dp"/>

</LinearLayout>
