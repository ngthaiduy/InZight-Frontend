<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp"
    android:paddingTop="50dp"
    android:background="@color/white"
    tools:context=".fragments.TransactionHistoryFragment">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transaction History"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        android:layout_marginBottom="20dp" />

    <!-- Filter bar -->
    <LinearLayout
        android:id="@+id/filterContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnStartDate"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Start"
            android:textColor="#1565C0"
            android:textSize="12sp"
            android:background="@drawable/bg_filter_button_modern"
            android:elevation="2dp"
            android:layout_marginEnd="4dp"
            app:backgroundTint="@null"/>

        <Button
            android:id="@+id/btnEndDate"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="End"
            android:textColor="#1565C0"
            android:textSize="12sp"
            android:background="@drawable/bg_filter_button_modern"
            android:elevation="2dp"
            app:backgroundTint="@null"/>

        <Button
            android:id="@+id/btnSortTime"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:text="Newest ▼"
            android:textColor="#1565C0"
            android:textSize="12sp"
            android:background="@drawable/bg_filter_button_modern"
            android:elevation="2dp"
            app:backgroundTint="@null"/>

        <ImageButton
            android:id="@+id/btnApplyFilter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_filter_bx"
            android:background="@drawable/bg_button_circle_gradient"
            android:elevation="4dp"
            android:padding="12dp"
            android:contentDescription="Filter"
            app:tint="@android:color/white"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No transactions found."
        android:gravity="center"
        android:textSize="16sp"
        android:textColor="#546E7A"
        android:paddingTop="24dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTransactions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_transaction_card" />
</LinearLayout>
