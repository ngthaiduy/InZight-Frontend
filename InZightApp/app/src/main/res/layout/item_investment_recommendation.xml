<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:strokeColor="#757575"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivInvestmentIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_finance"
            app:tint="#42A5F5"
            android:visibility="visible"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvInvestmentTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-invest 4M/month in growth ETFs"
                android:textSize="12sp"
                android:textStyle="italic"/>

            <TextView
                android:id="@+id/tvInvestmentAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.000.000 VNĐ"
                android:textSize="10sp"
                android:textColor="#757575"
                android:layout_marginTop="4dp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

