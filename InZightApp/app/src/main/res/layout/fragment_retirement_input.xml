<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="50dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back"
                app:tint="@color/home_text_strong"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Retirement Dream"
                    android:textColor="@color/home_text_strong"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimate your savings for a comfortable future"
                    android:textColor="@color/home_text_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="italic"/>
            </LinearLayout>
            
             <View
                android:layout_width="24dp"
                android:layout_height="24dp" />
        </LinearLayout>

        <!-- Real-time Preview Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:visibility="gone">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 Preview"
                    android:textColor="@color/home_text_strong"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Future Value:"
                        android:textColor="@color/home_text_muted"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/tvPreviewFutureValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 VND"
                        android:textColor="@color/home_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Monthly Savings Needed:"
                        android:textColor="@color/home_text_muted"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/tvPreviewMonthlySavings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 VND"
                        android:textColor="@color/green_600"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 1: Retirement Without Pension -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Retirement Without Pension"
                android:textColor="@color/home_text_strong"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- Current Age -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Age"
                android:textColor="@color/home_text_strong"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etCurrentAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_switch_item"
                android:backgroundTint="#FFFFFF"
                android:hint="Your current age (no decimal number)"
                android:padding="12dp"
                android:textSize="14sp"
                android:inputType="number"
                android:textColor="@color/home_text_strong"
                android:layout_marginBottom="16dp"/>
            
            <!-- Retire at -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                 android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Retire at"
                    android:textColor="@color/home_text_strong"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/tvRetireAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/home_text_strong"
                    android:textStyle="bold"
                    android:textSize="14sp"/>
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderRetireAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="100"
                android:value="60"
                app:thumbColor="#1976D2"
                app:trackColorActive="#1976D2"
                app:trackColorInactive="#E0E0E0"
                android:layout_marginBottom="16dp"/>

            <!-- Current Income -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Income (VND/month)"
                android:textColor="@color/home_text_strong"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etCurrentIncome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_switch_item"
                android:backgroundTint="#FFFFFF"
                android:hint="Enter monthly income"
                android:padding="12dp"
                android:textSize="14sp"
                android:inputType="numberDecimal"
                android:textColor="@color/home_text_strong"
                android:layout_marginBottom="16dp"/>

            <!-- Current Savings -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Savings (VND)"
                android:textColor="@color/home_text_strong"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etCurrentSavings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_switch_item"
                android:backgroundTint="#FFFFFF"
                android:hint="Enter current savings"
                android:padding="12dp"
                android:textSize="14sp"
                android:inputType="numberDecimal"
                android:textColor="@color/home_text_strong"
                android:layout_marginBottom="16dp"/>

            <!-- Monthly Expense -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monthly Expense (VND)"
                android:textColor="@color/home_text_strong"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etMonthlyExpense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_switch_item"
                android:backgroundTint="#FFFFFF"
                android:hint="Enter monthly expenses"
                android:padding="12dp"
                android:textSize="14sp"
                android:inputType="numberDecimal"
                android:textColor="@color/home_text_strong"
                android:layout_marginBottom="16dp"/>

            <!-- Monthly Savings (Optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monthly Savings Contribution (VND) - Optional"
                android:textColor="@color/home_text_strong"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etMonthlySavings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_switch_item"
                android:backgroundTint="#FFFFFF"
                android:hint="Monthly savings (optional)"
                android:padding="12dp"
                android:textSize="14sp"
                android:inputType="numberDecimal"
                android:textColor="@color/home_text_strong"
                android:layout_marginBottom="16dp"/>

            <!-- Expected Annual Return -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expected Annual Return"
                android:textColor="@color/home_text_strong"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_switch_item"
                android:backgroundTint="#FFFFFF"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginBottom="16dp">
                
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav_optimizer"
                    app:tint="#4CAF50"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/etAnnualReturn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="(Percentage)"
                    android:textSize="14sp"
                    android:inputType="numberDecimal"
                    android:textColor="@color/home_text_strong"/>
            </LinearLayout>

            <!-- Expected Inflation Rate -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expected Inflation Rate"
                android:textColor="@color/home_text_strong"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_switch_item"
                android:backgroundTint="#FFFFFF"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav_scenario"
                    app:tint="#FFC107"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/etInflationRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="(Percentage)"
                    android:textSize="14sp"
                    android:inputType="numberDecimal"
                    android:textColor="@color/home_text_strong"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculatePension"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CALCULATE"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:padding="14dp"
                android:backgroundTint="@color/home_primary"
                android:elevation="4dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 2: Retirement Life Planner -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Retirement Life Planner"
                android:textColor="@color/home_text_strong"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="4dp"/>
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Activities Allocation"
                android:textColor="@color/home_text_strong"
                android:textSize="14sp"
                android:textStyle="italic"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E3F2FD">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SET UP"
                        android:textColor="@color/home_text_strong"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Choose Activities"
                        android:textColor="@color/home_text_strong"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp"/>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:layout_marginBottom="16dp">

                        <CheckBox
                            android:id="@+id/cbTravel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Travel"
                            android:layout_columnWeight="1"/>
                        
                        <CheckBox
                            android:id="@+id/cbRecreations"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recreations"
                            android:layout_columnWeight="1"/>

                        <CheckBox
                            android:id="@+id/cbEducation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Education"
                            android:layout_columnWeight="1"/>

                        <CheckBox
                            android:id="@+id/cbHealthcare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Healthcare"
                            android:layout_columnWeight="1"/>
                    </GridLayout>

                    <!-- Expected Annual Cost -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Expected Annual Cost"
                            android:textColor="@color/home_text_strong"
                            android:textSize="12sp"/>
                        
                        <EditText
                            android:id="@+id/etAnnualCost"
                            android:layout_width="100dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_home_switch_item"
                            android:backgroundTint="#FFFFFF"
                            android:hint="2.5M VND"
                            android:gravity="center"
                            android:textSize="12sp"
                            android:inputType="numberDecimal"
                            android:padding="4dp"/>
                    </LinearLayout>

                    <!-- Number of Years -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Number of Years"
                            android:textColor="@color/home_text_strong"
                            android:textSize="12sp"/>

                        <LinearLayout
                            android:layout_width="100dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_home_switch_item"
                            android:backgroundTint="#FFFFFF"
                            android:gravity="center"
                            android:orientation="horizontal">
                            
                            <TextView
                                android:id="@+id/btnDecreaseYears"
                                android:layout_width="30dp"
                                android:layout_height="match_parent"
                                android:text="-"
                                android:gravity="center"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:clickable="true"
                                android:focusable="true"/>
                            
                            <TextView
                                android:id="@+id/tvYears"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:text="5"
                                android:gravity="center"
                                android:textSize="14sp"/>

                            <TextView
                                android:id="@+id/btnIncreaseYears"
                                android:layout_width="30dp"
                                android:layout_height="match_parent"
                                android:text="+"
                                android:gravity="center"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:clickable="true"
                                android:focusable="true"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Life-style -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Life-style"
                        android:textColor="@color/home_text_strong"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Very Passive"
                            android:textSize="10sp"
                            android:gravity="start"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0%"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Very Active"
                            android:textSize="10sp"
                            android:gravity="end"/>
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderLifestyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:value="0"
                        app:thumbColor="#1976D2"
                        app:trackColorActive="#1976D2"
                        app:trackColorInactive="#E0E0E0"/>
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="-8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0%"
                            android:textSize="10sp"
                            android:gravity="start"
                            android:layout_marginStart="8dp"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="75%"
                            android:textSize="10sp"
                            android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="100%"
                            android:textSize="10sp"
                            android:gravity="end"
                            android:layout_marginEnd="8dp"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculatePlanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CALCULATE"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:padding="14dp"
                android:backgroundTint="@color/home_primary"
                android:elevation="4dp"
                android:layout_marginTop="24dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
